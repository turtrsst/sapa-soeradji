# ===== SOERA AI — contoh konfigurasi lingkungan =====
# Salin ke .env.local (dev) atau set sebagai environment variable (produksi).

# Wajib di produksi: rahasia penandatangan cookie sesi admin (string acak panjang, mis. `openssl rand -hex 48`)
SOERA_ADMIN_SECRET=

# Wajib di produksi: kredensial admin.
# Cara paling aman (bcrypt): generate hash lalu isi SOERA_ADMIN_PASSWORD_HASH
#   node -e "console.log(require('bcryptjs').hashSync('password-kuat-anda', 12))"
SOERA_ADMIN_PASSWORD_HASH=
# Alternatif sederhana (plain, dibandingkan timing-safe): 
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Lokasi database SQLite (default ./data). Di Windows Server: C:\xampp\htdocs\soera-ai\data
SAPA_DATA_DIR=

# URL publik (untuk robots.txt & sitemap.xml). Contoh: https://sias.rsupsoeradji.id/soera-ai
SOERA_PUBLIC_URL=https://sias.rsupsoeradji.id/soera-ai

# Sub-path deploy (mis. sias.rsupsoeradji.id/soera-ai/). WAJIB sama saat build & saat service berjalan.
# Kosongkan (atau hapus) bila disajikan di root host sendiri.
# SOERA_BASE_PATH=/soera-ai

# Batas kuota AI bebas (pertanyaan/pengguna/hari, reset 00.00 WIB)
SOERA_AI_DAILY_LIMIT=10

# Rate limit endpoint publik (in-memory, per IP)
SOERA_RATE_CHAT_LIMIT=30
SOERA_RATE_CHAT_WINDOW_MS=300000
SOERA_RATE_LOGIN_LIMIT=5
SOERA_RATE_LOGIN_WINDOW_MS=600000
SOERA_RATE_PUBLIC_POST_LIMIT=10
SOERA_RATE_PUBLIC_POST_WINDOW_MS=3600000
